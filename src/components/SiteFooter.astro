---
import { navigation, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-primary">
    <p class="section-index">Research / Engineering / Blog</p>
    <p class="footer-statement">Every useful theory leaves room for the world to disagree.</p>
    <div class="footer-links" aria-label="Contact and profiles">
      <a class="footer-link" href={`mailto:${site.email}`}>Email <span aria-hidden="true">↗</span></a>
      <a class="footer-link" href={site.github}>GitHub <span aria-hidden="true">↗</span></a>
      <a class="footer-link" href={site.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a>
      <a class="footer-link" href={site.arxiv}>arXiv <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="shell footer-secondary">
    <p>© {year} Guo Jiaxing</p>
    <nav aria-label="Footer navigation">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</footer>
