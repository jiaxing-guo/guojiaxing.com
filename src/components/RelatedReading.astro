---
interface RelatedItem {
  eyebrow: string;
  title: string;
  summary: string;
  href: string;
}

interface Props {
  items: RelatedItem[];
}

const { items } = Astro.props;
---

<section id="related-reading" class="related-reading" aria-labelledby="related-reading-title">
  <h2 id="related-reading-title" class="related-reading-label">Related reading</h2>
  <div>
    {items.map((item) => (
      <a class="related-reading-item" href={item.href}>
        <span>{item.eyebrow}</span>
        <div>
          <h3>{item.title}</h3>
          <p>{item.summary}</p>
        </div>
        <span aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
</section>

<style>
  .related-reading {
    margin-top: 84px;
    border-top: 1px solid var(--ink);
    font-family: var(--sans);
    scroll-margin-top: 28px;
  }

  .related-reading-label {
    margin: 0;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    color: var(--signal);
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 780;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .related-reading-item {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr) auto;
    gap: 18px;
    align-items: start;
    padding: 22px 0 24px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }

  .related-reading-item > span:first-child {
    padding-top: 5px;
    color: var(--muted);
    font-size: 9px;
    font-weight: 760;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .related-reading-item > span:last-child {
    color: var(--signal);
    font-size: 18px;
    transition: transform 180ms ease;
  }

  .related-reading-item h3 {
    margin: 0 0 6px;
    font-family: var(--display);
    font-size: 25px;
    font-weight: 520;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  .related-reading-item p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.45;
  }

  .related-reading-item:hover h3,
  .related-reading-item:focus-visible h3 {
    color: var(--signal);
  }

  .related-reading-item:hover > span:last-child,
  .related-reading-item:focus-visible > span:last-child {
    transform: translate(3px, -3px);
  }

  @media (max-width: 620px) {
    .related-reading {
      margin-top: 68px;
    }

    .related-reading-item {
      grid-template-columns: 1fr auto;
      gap: 9px 14px;
    }

    .related-reading-item > span:first-child {
      grid-column: 1;
      padding-top: 0;
    }

    .related-reading-item > div {
      grid-row: 2;
      grid-column: 1;
    }

    .related-reading-item > span:last-child {
      grid-row: 1 / span 2;
      grid-column: 2;
    }
  }
</style>
