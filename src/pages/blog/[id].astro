---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BlogComments from '../../components/BlogComments.astro';
import RelatedReading from '../../components/RelatedReading.astro';
import { site } from '../../data/site';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { formatDate } from '../../utils/date';
import { createBlogPostingSchema } from '../../utils/structuredData';

export async function getStaticPaths() {
  const entries = await getCollection('blog', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const tableOfContents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const blogPath = `/blog/${entry.id}/`;
const heroImage = entry.data.image
  ? {
      src: entry.data.image.src,
      alt: entry.data.image.alt,
      width: entry.data.image.width,
      height: entry.data.image.height,
      mobile: entry.data.image.mobile,
      caption: entry.data.image.caption,
    }
  : undefined;
const socialImage = entry.data.image
  ? {
      src: entry.data.image.social.src,
      alt: entry.data.image.alt,
      width: entry.data.image.social.width,
      height: entry.data.image.social.height,
      type: entry.data.image.social.type,
    }
  : null;
const structuredData = createBlogPostingSchema({
  path: blogPath,
  title: entry.data.title,
  summary: entry.data.summary,
  publishedAt: entry.data.publishedAt,
  updatedAt: entry.data.updatedAt,
  tags: entry.data.tags,
  images: entry.data.image?.structured,
});
const dateMeta = entry.data.updatedAt
  ? `${formatDate(entry.data.publishedAt)} / Updated ${formatDate(entry.data.updatedAt)}`
  : formatDate(entry.data.publishedAt);
---

<ContentLayout
  title={entry.data.title}
  pageTitle={entry.data.seoTitle}
  summary={entry.data.summary}
  eyebrow="Blog"
  meta={dateMeta}
  topics={entry.data.tags}
  backHref="/blog/"
  backLabel="All posts"
  tableOfContents={tableOfContents}
  heroImage={heroImage}
  socialImage={socialImage}
  publishedTime={entry.data.publishedAt}
  modifiedTime={entry.data.updatedAt}
  structuredData={structuredData}
  author={{ name: site.name, href: '/about/' }}
  hasComments
>
  <Content />
  <RelatedReading items={entry.data.related} />
  <Fragment slot="comments">
    <BlogComments />
  </Fragment>
</ContentLayout>
