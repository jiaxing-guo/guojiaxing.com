---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Guo Jiaxing" description="The requested page does not exist." socialImage={null} noindex>
  <main id="main-content" class="not-found shell">
    <p class="section-index">Error / 404</p>
    <h1>This path leads outside the known game.</h1>
    <p>The page moved, or the link was incorrect.</p>
    <a class="text-link" href="/">Return home <span aria-hidden="true">↗</span></a>
  </main>
</BaseLayout>
