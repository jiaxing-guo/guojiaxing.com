---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('research');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'research'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const links: Array<{ label: string; href: string }> = [];

if (entry.data.paper) links.push({ label: 'arXiv', href: entry.data.paper });
if (entry.data.pdf) links.push({ label: 'PDF', href: entry.data.pdf });
if (entry.data.attachment) links.push({ label: 'Download PDF', href: entry.data.attachment });
if (entry.data.doi) links.push({ label: 'DOI', href: entry.data.doi });
if (entry.data.repo) links.push({ label: 'Code', href: entry.data.repo });

const preprintMeta = entry.data.arxivId
  ? `${entry.data.status} / arXiv:${entry.data.arxivId}${entry.data.version ? ` ${entry.data.version}` : ''} / ${entry.data.year}`
  : `${entry.data.status} / ${entry.data.year}`;
---

<ContentLayout
  title={entry.data.title}
  summary={entry.data.summary}
  eyebrow="Research"
  meta={preprintMeta}
  topics={entry.data.topics}
  authors={entry.data.authors}
  backHref="/research/"
  backLabel="All research"
  links={links}
>
  <Content />
</ContentLayout>
