---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', site.url).href,
  url: new URL('/', site.url).href,
  name: site.name,
  alternateName: site.alternateName,
};

const selectedResearch = (await getCollection('research'))
  .filter((item) => item.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const selectedProjects = (await getCollection('projects'))
  .filter((item) => item.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const latestBlogPost = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
)[0];
---

<BaseLayout structuredData={websiteSchema}>
  <main id="main-content">
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <div>
          <p class="eyebrow">Researcher / Engineer</p>
          <h1 id="hero-title">Reliable decisions in uncertain worlds.</h1>
          <p class="hero-intro">
            I study intelligent systems that must reason with partial information,
            strategic behavior, and unreliable evidence.
          </p>
          <div class="hero-actions">
            <a class="text-link" href="#research">Explore research <span aria-hidden="true">↘</span></a>
            <a class="text-link" href="https://github.com/jiaxing-guo">View GitHub <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <div class="hero-note">
          <strong>Current focus</strong>
          <span>Computational game theory, policy certification, and scalable learning systems.</span>
        </div>
      </div>

      <div class="signal-field" aria-label="A visual map connecting observation, reasoning, and action">
        <span class="field-axis field-axis--horizontal" aria-hidden="true"></span>
        <span class="field-axis field-axis--vertical" aria-hidden="true"></span>
        <span class="field-node field-node--one">Observe</span>
        <span class="field-node field-node--two">Reason</span>
        <span class="field-node field-node--three">Act</span>
        <span class="field-label">Signal / Strategy / System</span>
      </div>
    </section>

    <section class="research-section shell" id="research" aria-labelledby="research-title">
      <div class="section-heading">
        <p class="section-index">01 / Selected work</p>
        <h2 id="research-title">Research with a clear point of view.</h2>
        <a class="section-link" href="/research/">All research ↗</a>
      </div>

      <div class="research-list">
        {selectedResearch.map((item, index) => (
          <a class="research-item" href={`/research/${item.id}/`}>
            <p class="research-meta">R.0{index + 1} / {item.data.year}</p>
            <h3>{item.data.shortTitle ?? item.data.title}</h3>
            <div>
              <p>{item.data.summary}</p>
              <p class="research-meta">{item.data.status} · {item.data.topics[0]}</p>
            </div>
            <span class="research-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="focus-section">
      <div class="shell focus-grid">
        <div class="focus-intro">
          <p class="section-index">02 / Point of view</p>
          <h2>Reliability is a property to test, not a label to claim.</h2>
        </div>
        <ol class="focus-list">
          <li>
            <span>01</span>
            <div>
              <h3>Observe</h3>
              <p>Identify which information changes a decision and what that information costs.</p>
            </div>
          </li>
          <li>
            <span>02</span>
            <div>
              <h3>Reason</h3>
              <p>Expose assumptions, strategic incentives, and the strongest available counterexample.</p>
            </div>
          </li>
          <li>
            <span>03</span>
            <div>
              <h3>Certify</h3>
              <p>State what the system can guarantee and where that guarantee stops.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="projects-section shell" aria-labelledby="projects-title">
      <div class="section-heading">
        <p class="section-index">03 / Selected project work</p>
        <h2 id="projects-title">Code as a research instrument.</h2>
        <a class="section-link" href="/project/">All project work ↗</a>
      </div>
      <div class="project-grid">
        {selectedProjects.map((project, index) => (
          <a class="project-card" href={`/project/${project.id}/`}>
            <div class="project-card-topline">
              <span>P.0{index + 1}</span>
              <span>{project.data.languages.join(' + ')}</span>
            </div>
            <h3>{project.data.title}</h3>
            <p>{project.data.summary}</p>
            <div class="project-card-footer">
              <span>{project.data.topics.join(' / ')}</span>
              <span aria-hidden="true">↗</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="blog-teaser shell">
      <p class="section-index">04 / Blog</p>
      <div>
        <h2>{latestBlogPost?.data.title ?? 'Notes from the boundary between theory and systems.'}</h2>
        <p>{latestBlogPost?.data.summary ?? 'Long-form research explanations and working notes will appear here.'}</p>
      </div>
      <a class="text-link" href={latestBlogPost ? `/blog/${latestBlogPost.id}/` : '/blog/'}>
        {latestBlogPost ? 'Read latest post' : 'Visit blog'} <span aria-hidden="true">↗</span>
      </a>
    </section>
  </main>
</BaseLayout>
