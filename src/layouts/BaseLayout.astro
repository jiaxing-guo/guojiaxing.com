---
import '@fontsource-variable/manrope';
import '@fontsource-variable/newsreader';
import '../styles/global.css';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../data/site';
import type { SocialImage } from '../types/media';
import type { StructuredData } from '../utils/structuredData';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  socialImage?: SocialImage | null;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  articleSection?: string;
  articleTags?: string[];
  structuredData?: StructuredData | StructuredData[];
}

const {
  title = site.title,
  description = site.description,
  path = Astro.url.pathname,
  socialImage = site.socialImage,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  articleSection,
  articleTags = [],
  structuredData,
} = Astro.props;

const canonical = new URL(path, site.url);
const authorUrl = new URL('/about/', site.url);
const imageUrl = socialImage ? new URL(socialImage.src, site.url) : null;
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': new URL('/#person', site.url).href,
  name: site.name,
  alternateName: site.alternateName,
  url: authorUrl.href,
  email: site.email,
  sameAs: [site.github, site.linkedin, site.arxiv],
  affiliation: site.affiliations.map((name) => ({
    '@type': 'Organization',
    name,
  })),
  jobTitle: site.role,
  worksFor: {
    '@type': 'Organization',
    name: site.company,
  },
  knowsAbout: [
    'Computational game theory',
    'Imperfect-information games',
    'Policy certification',
    'Machine learning',
  ],
};
const pageSchemas = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f2f0e9" />
    <meta name="application-name" content="Guo Jiaxing" />
    <meta name="apple-mobile-web-app-title" content="Guo Jiaxing" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'max-image-preview:large'} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#4056f4" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Guo Jiaxing — Blog" href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    {imageUrl && socialImage && (
      <>
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:secure_url" content={imageUrl} />
        <meta property="og:image:type" content={socialImage.type} />
        <meta property="og:image:width" content={String(socialImage.width)} />
        <meta property="og:image:height" content={String(socialImage.height)} />
        <meta property="og:image:alt" content={socialImage.alt} />
      </>
    )}
    {type === 'article' && <meta property="article:author" content={authorUrl} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {type === 'article' && articleSection && <meta property="article:section" content={articleSection} />}
    {type === 'article' && articleTags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && socialImage && (
      <>
        <meta name="twitter:image" content={imageUrl} />
        <meta name="twitter:image:alt" content={socialImage.alt} />
      </>
    )}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {pageSchemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <AnalyticsConsent />
  </body>
</html>
