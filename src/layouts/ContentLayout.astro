---
import BaseLayout from './BaseLayout.astro';
import 'katex/dist/katex.min.css';
import type { StructuredData } from '../utils/structuredData';

interface Props {
  title: string;
  summary: string;
  eyebrow: string;
  meta: string;
  topics: string[];
  backHref: string;
  backLabel: string;
  authors?: string[];
  links?: Array<{ label: string; href: string }>;
  tableOfContents?: Array<{ depth: number; slug: string; text: string }>;
  publishedTime?: Date;
  modifiedTime?: Date;
  structuredData?: StructuredData | StructuredData[];
}

const {
  title,
  summary,
  eyebrow,
  meta,
  topics,
  backHref,
  backLabel,
  authors,
  links = [],
  tableOfContents = [],
  publishedTime,
  modifiedTime,
  structuredData,
} = Astro.props;
---

<BaseLayout
  title={`${title} — Guo Jiaxing`}
  description={summary}
  socialImage={null}
  type="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  structuredData={structuredData}
>
  <main id="main-content">
    <article class="entry shell">
      <a class="back-link" href={backHref}>← {backLabel}</a>
      <header class="entry-header">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p class="entry-summary">{summary}</p>
        <div class="entry-details">
          <p>{meta}</p>
          {authors && <p class="entry-authors">{authors.join(', ')}</p>}
          <p>{topics.join(' · ')}</p>
          <div class="entry-links">
            {links.map((link) => (
              <a class="text-link" href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>
            ))}
          </div>
        </div>
      </header>
      <div class:list={['entry-body', tableOfContents.length > 0 && 'entry-body--with-toc']}>
        {tableOfContents.length > 0 && (
          <aside class="entry-toc" aria-label="Table of contents">
            <p>On this page</p>
            <ol>
              {tableOfContents.map((heading) => (
                <li class:list={[heading.depth === 3 && 'entry-toc-subitem']}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </aside>
        )}
        <div class="prose">
          <slot />
        </div>
      </div>
    </article>
  </main>
</BaseLayout>
