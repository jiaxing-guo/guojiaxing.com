---
import BaseLayout from './BaseLayout.astro';
import 'katex/dist/katex.min.css';
import type { ContentImage, SocialImage } from '../types/media';
import type { StructuredData } from '../utils/structuredData';

interface Props {
  title: string;
  pageTitle?: string;
  summary: string;
  eyebrow: string;
  meta: string;
  topics: string[];
  backHref: string;
  backLabel: string;
  authors?: string[];
  links?: Array<{ label: string; href: string }>;
  tableOfContents?: Array<{ depth: number; slug: string; text: string }>;
  heroImage?: ContentImage;
  socialImage?: SocialImage | null;
  publishedTime?: Date;
  modifiedTime?: Date;
  structuredData?: StructuredData | StructuredData[];
  hasComments?: boolean;
}

const {
  title,
  pageTitle,
  summary,
  eyebrow,
  meta,
  topics,
  backHref,
  backLabel,
  authors,
  links = [],
  tableOfContents = [],
  heroImage,
  socialImage = null,
  publishedTime,
  modifiedTime,
  structuredData,
  hasComments = false,
} = Astro.props;
---

<BaseLayout
  title={`${pageTitle ?? title} — Guo Jiaxing`}
  description={summary}
  socialImage={socialImage}
  type="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  articleSection={eyebrow}
  articleTags={topics}
  structuredData={structuredData}
>
  <main id="main-content">
    <article id="article-top" class="entry shell">
      <a class="back-link" href={backHref}>← {backLabel}</a>
      <header class="entry-header">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p class="entry-summary">{summary}</p>
        <div class="entry-details">
          <p>{meta}</p>
          {authors && <p class="entry-authors">{authors.join(', ')}</p>}
          <p>{topics.join(' · ')}</p>
          <div class="entry-links">
            {links.map((link) => (
              <a class="text-link" href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>
            ))}
          </div>
        </div>
      </header>
      {heroImage && (
        <figure class:list={['entry-visual', heroImage.mobile && 'entry-visual--responsive']}>
          <p class="entry-visual-hint" aria-hidden="true">Swipe to inspect →</p>
          <div class="entry-visual-frame" tabindex="0" aria-label="Scrollable article figure">
            <picture>
              {heroImage.mobile && (
                <source
                  media="(max-width: 620px)"
                  srcset={heroImage.mobile.src}
                  width={heroImage.mobile.width}
                  height={heroImage.mobile.height}
                />
              )}
              <img
                src={heroImage.src}
                alt={heroImage.alt}
                width={heroImage.width}
                height={heroImage.height}
                loading="lazy"
                decoding="async"
              />
            </picture>
          </div>
          {heroImage.caption && <figcaption>{heroImage.caption}</figcaption>}
        </figure>
      )}
      <div class:list={['entry-body', tableOfContents.length > 0 && 'entry-body--with-toc']}>
        {tableOfContents.length > 0 && (
          <aside class:list={['entry-toc', hasComments && 'entry-toc--with-comments']} aria-label="Table of contents">
            <p>On this page</p>
            <ol>
              {tableOfContents.map((heading) => (
                <li class:list={[heading.depth === 3 && 'entry-toc-subitem']}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
            {hasComments && (
              <nav class="entry-toc-actions" aria-label="Article shortcuts">
                <a href="#discussion">Discussion <span aria-hidden="true">↓</span></a>
                <a href="#article-top">Top <span aria-hidden="true">↑</span></a>
              </nav>
            )}
          </aside>
        )}
        <div class="prose">
          <slot />
        </div>
        <slot name="comments" />
      </div>
    </article>
  </main>
</BaseLayout>
